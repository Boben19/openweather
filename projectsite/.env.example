# Copy this file to ".env" (same folder as manage.py) and fill in your values.
# Never commit ".env". It is listed in .gitignore.

# Get a free key at https://openweathermap.org/api (new keys can take a while to activate).
OPENWEATHER_API_KEY=

# Local development: True. Production: False (or remove the line).
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated host names. Needed when DJANGO_DEBUG is False.
# DJANGO_ALLOWED_HOSTS=weather.example.com

# With DEBUG off, HTTPS is assumed (secure cookies, HTTP -> HTTPS redirect).
# Set to false only to test a non-debug server over plain HTTP.
# DJANGO_HTTPS=false

# Optional
# DEFAULT_CITY=Puerto Princesa      # shown on first load; empty = start with the search prompt
# WEATHER_CACHE_SECONDS=600         # 0 turns caching off
